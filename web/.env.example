# Sanity project the storefront reads from. Same project the studio writes to.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Public site URL, no trailing slash. Used for canonical tags and the absolute
# URLs Open Graph needs. Leave unset and those tags are simply omitted, which
# is safer than emitting ones that point at the wrong origin.
NEXT_PUBLIC_SITE_URL=

# Shown in page titles and og:site_name. Defaults to "JAMcommerce".
NEXT_PUBLIC_SITE_NAME=

# Snipcart public API key, from your Snipcart dashboard under API keys.
# Public by design (it ships to the browser) but tied to your account, so it
# does not belong hardcoded in a public repo.
#
# Leave it empty and Snipcart is not loaded at all: no third-party stylesheet,
# script or preconnects on any page. The built-in cart works either way.
NEXT_PUBLIC_SNIPCART_API_KEY=
