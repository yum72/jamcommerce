# Sanity project the storefront reads from. Same project the studio writes to.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Snipcart public API key, from your Snipcart dashboard under API keys.
# Public by design (it ships to the browser) but tied to your account, so it
# does not belong hardcoded in a public repo.
NEXT_PUBLIC_SNIPCART_API_KEY=
